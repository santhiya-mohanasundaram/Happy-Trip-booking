# ==========================================
# TripEase Travel Booking System - Environment Example
# Copy this file to .env and replace placeholder values with your local configuration.
# DO NOT commit the actual .env file or real credentials to GitHub.
# ==========================================

# Server Configuration
SERVER_PORT=8080
API_BASE_URL=http://localhost:8080/api

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=travel_booking_db
DB_USERNAME=your_mysql_username
DB_PASSWORD=your_mysql_password

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_minimum_256_bits
AUTH_TOKEN_SECRET=your_auth_token_secret

# Payment Gateway Configuration (Mock / Test / Live)
PAYMENT_GATEWAY_MODE=MOCK
PAYMENT_GATEWAY_KEY=pk_test_tripease_mock_key_2026
PAYMENT_GATEWAY_SECRET=sk_test_tripease_mock_secret_2026

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080

